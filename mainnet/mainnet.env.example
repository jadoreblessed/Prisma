# Never commit real RPC credentials or private keys.
SOLANA_MAINNET_RPC=https://YOUR-PRIVATE-MAINNET-RPC
ANCHOR_WALLET=/absolute/path/to/prisma-mainnet.json
PRISMA_CHAINLINK_FEED=OFFICIAL_NVDAx_USD_CHAINLINK_FEED
# Optional persistent location. The default is mainnet/keys/prisma_lending-keypair.json.
PRISMA_PROGRAM_KEYPAIR=/absolute/path/to/prisma_lending-keypair.json
